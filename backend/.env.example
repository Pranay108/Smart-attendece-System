# Multimodal Attendance & Engagement Agent Configuration
PROJECT_NAME="Multimodal Attendance & Engagement Agent"
VERSION="1.0.0"
API_V1_PREFIX="/api"

# Database Configuration (SQLite default, PostgreSQL supported)
DATABASE_URL=sqlite:///attendance.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/attendance_db

# Security & JWT Tokens
SECRET_KEY=change-this-to-a-secure-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Computer Vision & Biometric Matching Thresholds (0.0 to 1.0)
MATCH_CONFIDENCE_THRESHOLD=0.72
REVIEW_THRESHOLD=0.55

# Media Upload Limits
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=100

# Optional External AI Provider Keys (for AI Assistant LLM fallback)
# Note: The application operates 100% deterministically from verified backend database tools even without external keys
OPENAI_API_KEY=
GEMINI_API_KEY=
